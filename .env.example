# Odoo Connection Configuration
# Replace these with your actual Odoo instance details
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=your-database-name
ODOO_USERNAME=your-username
ODOO_PASSWORD=your-password-or-api-key
ODOO_TIMEOUT=30
ODOO_VERIFY_SSL=1

# PostgreSQL Database Configuration
POSTGRES_DB=mcp_auth
POSTGRES_USER=mcp_user
POSTGRES_PASSWORD=mcp_password

# Authentication Configuration
# Set to 'true' to enable bearer token authentication
AUTH_ENABLED=true
AUTH_DB_TYPE=postgres
AUTH_DB_HOST=postgres
AUTH_DB_PORT=5432
AUTH_DB_NAME=mcp_auth
AUTH_DB_USER=mcp_user
AUTH_DB_PASSWORD=mcp_password

# HTTP Server Configuration
# These are typically fine as-is
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# Debug Configuration
# Set to '1' to enable debug logging
DEBUG=0
